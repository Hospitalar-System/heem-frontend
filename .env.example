# API do HEEM. Sem ela o app inicia em modo de demonstração (dados locais).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Keycloak: realm e client usados no login direto por e-mail e senha.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/heem
VITE_OIDC_CLIENT_ID=heem-frontend

# Supabase Auth (Story F9.1). VITE_AUTH_PROVIDER = supabase | keycloak; sem ele, usa supabase se a URL estiver definida.
# A anon key é PÚBLICA. Nunca coloque a service role em variável VITE_*.
# VITE_AUTH_PROVIDER=supabase
# Staging (valores públicos): VITE_SUPABASE_URL=https://anuixewvvzfqyrjoplri.supabase.co
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# Staging (publishable, pública): VITE_SUPABASE_ANON_KEY=sb_publishable_OUNpPfVSkQiqBLmE2qw5Vg_E1MHmiCl
# VITE_SUPABASE_ANON_KEY=<anon-key-publica>

# Landing (Story L4): URL pública do site, sem barra final. Vazio = URLs relativas e sem sitemap.xml.
# VITE_SITE_URL=https://exemplo.com.br
